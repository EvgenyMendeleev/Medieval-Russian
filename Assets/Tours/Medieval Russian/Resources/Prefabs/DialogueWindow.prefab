  m_text: "\u041B\u0435\u0442\u043E\u043F\u0438\u0441\u0435\u0446, \u043F\u0440\u0438\u0432\u0435\u0442!
    \u0414\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
    \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440, \u043D\u0430\u0432\u0435\u0434\u0438
    \u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0443\u044E \u0438\u0437 \u043B\u044E\u0431\u043E\u0439
    \u0440\u0443\u043A\u0438 \u043B\u0430\u0437\u0435\u0440\u043D\u0443\u044E \u0443\u043A\u0430\u0437\u043A\u0443
    \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443 \"\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C\"
    \u0438 \u043D\u0430\u0436\u043C\u0438 \u043D\u0430 \u043A\u0443\u0440\u043E\u043A
    \u043D\u0430 VR \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A\u0435."
